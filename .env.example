# Copy this file to .env and fill in your own values. Never commit .env.

# Google Gemini API key (used by the guardrails model via Gemini's OpenAI-compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: NeMo Guardrails' openai engine reads this variable. Set it to the same key.
OPENAI_API_KEY=your-gemini-api-key-here

# Optional: local Ollama server (only needed if you use Ollama models)
OLLAMA_BASE_URL=http://localhost:11434
